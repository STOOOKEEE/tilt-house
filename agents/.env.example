# testnet (default) or mainnet; every account below must be of that network.
NETWORK=testnet
# House (floor) contract the keeper talks to.
HOUSE_CONTRACT=floor.tilthouse.testnet
# Optional.
# Comma-separated, preferred first: reads fail over on 429/5xx, transactions use the first only.
# NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org   (testnet default; mainnet: https://rpc.mainnet.fastnear.com)
# Root account: gamblers are g-<name>.<ACCOUNT_SUFFIX>; the defaults below derive from it.
# Default tilthouse.testnet on testnet, required on mainnet.
# ACCOUNT_SUFFIX=tilthouse.testnet
# TOKEN_CONTRACT=tusdc.<ACCOUNT_SUFFIX>
# Contract's keeper account (signs collect_rent, reprice, rent_bid; pays salaries).
# KEEPER_ACCOUNT=<ACCOUNT_SUFFIX>
# deposit (contract v2, default on testnet), credit_npc (contract v3; mainnet default) or off
# (no NPC gamblers, e.g. the TILT floor).
# SALARY_MODE=deposit
# 1: close_day(yesterday) after each UTC midnight (the USD floor only, reports to $TILT).
# CLOSE_DAY=0
# Directory of <account>.json key files (near-cli format). Default ~/.near-credentials/<NETWORK>.
# KEYS_DIR=
# KEEPER_INTERVAL_MS=60000
# Low-NEAR alerts (every 15 min, logged at level error). Thresholds in NEAR.
# SESSIONS_ACCOUNT=sessions.<ACCOUNT_SUFFIX>
# RELAYER_ACCOUNT=relayer.<ACCOUNT_SUFFIX>
# ALERT_KEEPER_NEAR=2
# ALERT_SESSIONS_NEAR=1
# ALERT_RELAYER_NEAR=1
# ALERT_NPC_NEAR=0.05
# Optional https webhook (Slack/Discord) that also receives each alert.
# ALERT_WEBHOOK_URL=
