# House contract the keeper talks to (testnet only).
HOUSE_CONTRACT=floor.tilthouse.testnet
# Optional.
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# TOKEN_CONTRACT=tusdc.tilthouse.testnet
# Contract's keeper account (signs collect_rent, reprice, rent_bid; pays salaries).
# KEEPER_ACCOUNT=tilthouse.testnet
# Gamblers are g-<name>.<ACCOUNT_SUFFIX>.
# ACCOUNT_SUFFIX=tilthouse.testnet
# Directory of <account>.json key files (near-cli format). Default ~/.near-credentials/testnet.
# KEYS_DIR=
# KEEPER_INTERVAL_MS=60000
