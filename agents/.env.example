# House contract the keeper and bots talk to (testnet only).
HOUSE_CONTRACT=house.tilthouse.testnet
# Optional.
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# Dealer accounts are <dealer_id>.<ACCOUNT_SUFFIX>, bots bot-<name>.<ACCOUNT_SUFFIX>.
# ACCOUNT_SUFFIX=tilthouse.testnet
# Directory of <account>.json key files (near-cli format). Default ~/.near-credentials/testnet.
# DEALER_KEYS_DIR=
# Directory of the bots' full-access key files. Default ~/.near-credentials/testnet.
# BOT_KEYS_DIR=
# KEEPER_INTERVAL_MS=60000
# Dealer the loyal bot always plays at. Default: first dice/roulette dealer by id.
# BOT_LOYAL_DEALER=
