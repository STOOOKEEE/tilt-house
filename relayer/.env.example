# testnet (default) or mainnet; named accounts below must be of that network.
NETWORK=testnet
HOUSE_CONTRACT=floor.tilthouse.testnet
# Project test token tUSDC (6 decimals); the relayer account is its minter
TOKEN_CONTRACT=tusdc.tilthouse.testnet
RELAYER_ACCOUNT=relayer.tilthouse.testnet
# Full-access key of RELAYER_ACCOUNT, ed25519:...
RELAYER_PRIVATE_KEY=
# Default per network: https://test.rpc.fastnear.com / https://rpc.mainnet.fastnear.com
NEAR_RPC_URL=https://test.rpc.fastnear.com
PORT=8787
# NEAR sent once to each new Privy implicit account by POST /activate
# (default 0.02 on testnet, 0.01 on mainnet: ~0.0038 NEAR of storage for the account and its two keys).
ACTIVATION_NEAR=0.02
# NEAR the relayer may spend per UTC day (activations, storage deposits, gas). Default 5 on
# testnet; required on mainnet.
DAILY_BUDGET_NEAR=5
# Testnet only (default 1): /activate also serves callers without a Privy token, e.g. the
# judges' CLI demo, one per account, 20/hour overall. Refused on mainnet.
# ANONYMOUS_ACTIVATION=1
# Kill switch: 1 = refuse every POST with 503 paused (restart the unit to apply).
RELAYER_PAUSED=0
# Privy app whose access tokens /activate accepts (default: the Tilt House app).
# PRIVY_APP_ID=cmw3anyvt021d0hjy746afxqi
# Holds state.json (activated Privy users, daily budget counter). Default ~/.tilt-house/relayer-<network>.
# RELAYER_DATA_DIR=
