# ~/.tilt-house/session-server-mainnet.env (chmod 600). Fill ROOT = the mainnet root account.
HOUSE_CONTRACT=floor.ROOT
SESSION_SERVER_ACCOUNT=sessions.ROOT
# SESSION_SERVER_PRIVATE_KEY (a NEW key, not testnet's) is appended by the docs/mainnet.md command.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
SESSION_SERVER_ADDR=127.0.0.1:8792
SESSION_DATA_DIR=/home/hermes/.tilt-house/sessions-mainnet
GAMBLER_KEYS_DIR=/home/hermes/.near-credentials/mainnet
# NPC gamblers are g-<name><suffix> (needs the session server with GAMBLER_ACCOUNT_SUFFIX support).
GAMBLER_ACCOUNT_SUFFIX=.ROOT
