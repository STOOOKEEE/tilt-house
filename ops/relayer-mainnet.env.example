# ~/.tilt-house/relayer-mainnet.env (chmod 600). Fill ROOT = the mainnet root account.
NETWORK=mainnet
HOST=127.0.0.1
PORT=8798
HOUSE_CONTRACT=floor.ROOT
TOKEN_CONTRACT=tusdc.ROOT
RELAYER_ACCOUNT=relayer.ROOT
# RELAYER_PRIVATE_KEY is appended by the docs/mainnet.md command (never typed, never printed).
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
ACTIVATION_NEAR=0.01
# Hard cap on what the relayer spends per UTC day (activations + gas + storage deposits).
DAILY_BUDGET_NEAR=2
# Kill switch: 1 = every POST answers 503 paused (systemctl --user restart th-relayer-mainnet).
RELAYER_PAUSED=0
RELAYER_DATA_DIR=/home/hermes/.tilt-house/relayer-mainnet
