# ~/.tilt-house/session-server-tilt.env (chmod 600): the TILT floor's session server (docs/ops-tilt.md).
HOUSE_CONTRACT=floor-tilt.tilthouse.testnet
SESSION_SERVER_ACCOUNT=sessions.tilthouse.testnet
# SESSION_SERVER_PRIVATE_KEY (a NEW key, not th-sessions': its own nonces, its public key is
# floor-tilt's server_pubkey) is appended by the docs/ops-tilt.md command.
# Reads fail over to drpc; transactions go to the first URL only.
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
SESSION_SERVER_ADDR=127.0.0.1:8793
SESSION_DATA_DIR=/home/hermes/.tilt-house/sessions-tilt
# No NPC gamblers on the TILT floor (no lineup, no NPC at poker tables).
GAMBLERS=off
