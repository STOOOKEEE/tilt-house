# ~/.tilt-house/keeper-tilt.env: the TILT floor's keeper (docs/ops-tilt.md).
NETWORK=testnet
HOUSE_CONTRACT=floor-tilt.tilthouse.testnet
TOKEN_CONTRACT=tilt.tilthouse.testnet
# Keeper of floor-tilt (scripts/deploy-floor.sh tilt), as on the USD floor.
KEEPER_ACCOUNT=tilthouse.testnet
# No NPC gamblers: no salaries, no NPC watched for NEAR.
SALARY_MODE=off
# close_day runs on the USD floor's keeper only.
CLOSE_DAY=0
KEYS_DIR=/home/hermes/.near-credentials/testnet
