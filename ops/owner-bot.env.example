# ~/.tilt-house/owner-bot.env: the house test owners' bot (ops/th-owner-bot.service). Testnet only.
HOUSE_CONTRACT=floor.tilthouse.testnet
# <table id>=<its controller>; keys in KEYS_DIR/<account>.json (agents/src/owner-setup.ts made them).
OWNER_TABLES=test-1=test-owner-1.tilthouse.testnet,test-2=test-owner-2.tilthouse.testnet
# Session server (the gamblers feed), loopback on this host.
SESSION_URL=http://127.0.0.1:8791
# Optional.
# OWNER_BOT_INTERVAL_MS=20000
# Highest rent per hour it pays to keep or win a seat, tUSDC base units (2 tUSDC/h: any seat at its minimum).
# OWNER_BOT_MAX_RENT=2000000
# KEYS_DIR=~/.near-credentials/testnet
# NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
