# ~/.tilt-house/relayer-tilt.env (chmod 600): the TILT floor's relayer (docs/ops-tilt.md).
NETWORK=testnet
HOST=127.0.0.1
PORT=8789
HOUSE_CONTRACT=floor-tilt.tilthouse.testnet
TOKEN_CONTRACT=tilt.tilthouse.testnet
TILT_CONTRACT=tilt.tilthouse.testnet
# /faucet claims the TILT welcome (claim_welcome_for) once per Privy user; activation mints nothing.
FAUCET_MODE=welcome
# The TILT token's welcome operator. RELAYER_PRIVATE_KEY is appended by the docs/ops-tilt.md
# command: a second full-access key of this account (own nonces), never typed, never printed.
RELAYER_ACCOUNT=relayer.tilthouse.testnet
# Reads fail over to drpc; transactions go to the first URL only.
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
# Sent only to an account that does not exist yet (the tUSDC relayer may have funded it).
ACTIVATION_NEAR=0.02
# The budget watches relayer.tilthouse.testnet's balance, which both relayers spend: it caps the
# account's total spend per UTC day, like the tUSDC relayer's (default 5).
DAILY_BUDGET_NEAR=5
# Welcome claims need a Privy login: no anonymous activations here.
ANONYMOUS_ACTIVATION=0
# Kill switch: 1 = every POST answers 503 paused (systemctl --user restart th-relayer-tilt).
RELAYER_PAUSED=0
# Its own state (activations, welcome claims, budget), apart from the tUSDC relayer's.
RELAYER_DATA_DIR=/home/hermes/.tilt-house/relayer-tilt
