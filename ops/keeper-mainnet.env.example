# ~/.tilt-house/keeper-mainnet.env. Fill ROOT = the mainnet root account (also the floor's keeper).
NETWORK=mainnet
HOUSE_CONTRACT=floor.ROOT
ACCOUNT_SUFFIX=ROOT
SALARY_MODE=credit_npc
KEYS_DIR=/home/hermes/.near-credentials/mainnet
# One pass per minute burns ~1.9 NEAR/day of keeper gas (testnet: ~12 txs/min at ~0.00035 NEAR).
# 300000 (5 min) cuts that to ~0.4 NEAR/day; rent and repricing then run every 5 minutes.
# KEEPER_INTERVAL_MS=300000
ALERT_KEEPER_NEAR=2
ALERT_SESSIONS_NEAR=1
ALERT_RELAYER_NEAR=1
ALERT_NPC_NEAR=0.05
# Optional https webhook (Slack/Discord) for low-NEAR alerts.
ALERT_WEBHOOK_URL=
