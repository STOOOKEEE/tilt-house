# Privy app id (dashboard.privy.io). The app must have NEAR embedded wallets enabled
# and http://localhost:5173 in its allowed origins.
VITE_PRIVY_APP_ID=
# House contract (game moves and the game key's receiver).
VITE_HOUSE_CONTRACT=
# Test USDC token contract (NEP-141 tUSDC; the relayer mints 100 on activation).
VITE_TOKEN_CONTRACT=tusdc.tilthouse.testnet
# Relayer base URL; the app posts to ${VITE_RELAYER_URL}/relay.
VITE_RELAYER_URL=http://localhost:8787
# Account the relayer signs with (its RELAYER_ACCOUNT); relayed VRF draws name it, so "verify the draw" accepts it.
VITE_RELAYER_ACCOUNT=relayer.tilthouse.testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
