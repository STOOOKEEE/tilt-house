# Privy app id (dashboard.privy.io). The app must have NEAR embedded wallets enabled
# and http://localhost:5173 in its allowed origins. Leave empty to run read-only (no login).
VITE_PRIVY_APP_ID=
# House contract (game moves and the game key's receiver).
VITE_HOUSE_CONTRACT=
# Test USDC token contract (NEP-141 tUSDC; the relayer mints 100 on activation).
VITE_TOKEN_CONTRACT=tusdc.tilthouse.testnet
# Relayer base URL; the app posts to ${VITE_RELAYER_URL}/relay.
VITE_RELAYER_URL=http://localhost:8787
# Account the relayer signs with (its RELAYER_ACCOUNT); relayed VRF draws name it, so "verify the draw" accepts it.
VITE_RELAYER_ACCOUNT=relayer.tilthouse.testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
# Session server (provably fair sessions + live NPC gamblers). Empty: no session play, demo floor from sim.json.
VITE_SESSION_URL=http://localhost:8790
# Mainnet (play money). Leave VITE_MAINNET_HOUSE_CONTRACT empty: the network switch stays hidden. Once set, the token and relayer account are required too (.near accounts).
VITE_MAINNET_HOUSE_CONTRACT=
VITE_MAINNET_TOKEN_CONTRACT=
VITE_MAINNET_RELAYER_ACCOUNT=
# Defaults: /mainnet/relayer, /mainnet/session (same-origin, proxied), https://rpc.mainnet.fastnear.com
# VITE_MAINNET_RELAYER_URL=
# VITE_MAINNET_SESSION_URL=
# VITE_MAINNET_NEAR_RPC_URL=
# $TILT floor (testnet): the same floor contract playing in TILT. Leave VITE_TILT_FLOOR empty: the
# USD | TILT switch stays hidden (the /tilt page still reads the token and the USD floor).
VITE_TILT_FLOOR=
# Defaults: tilt.tilthouse.testnet, /tilt/relayer, /tilt/session (same-origin, proxied), VITE_RELAYER_ACCOUNT
# VITE_TILT_TOKEN=
# VITE_TILT_RELAYER_URL=
# VITE_TILT_SESSION_URL=
# VITE_TILT_RELAYER_ACCOUNT=
